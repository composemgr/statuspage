# Statuspage (Cachet) - Open-source status page
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Hostname / Domain
BASE_HOST_NAME=$HOSTNAME
BASE_DOMAIN_NAME=example.com

# App secret key (must be 32 chars)
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Environment
APP_ENV=production
APP_DEBUG=false

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=statuspage
DB_USER_NAME=statuspage
DB_USER_PASS=changeme_db_password
